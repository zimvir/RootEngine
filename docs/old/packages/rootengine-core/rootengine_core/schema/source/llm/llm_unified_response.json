{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM Unified Response",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "响应 ID"
    },
    "model": {
      "type": "string",
      "description": "模型名称"
    },
    "message": {
      "type": "object",
      "description": "LLM 返回的消息",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["assistant", "tool"],
          "description": "消息角色"
        },
        "content": {
          "description": "LLM 回复的文字内容，无文字时为 null（纯工具调用场景）",
          "oneOf": [
            { "type": "null" },
            { "type": "string" }
          ]
        },
        "tool_calls": {
          "type": "array",
          "description": "LLM 发起的工具调用列表",
          "items": {
            "$ref": "../tool/tool_call.json"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "消息创建时间，ISO 8601 格式"
        },
        "extra": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "扩展数据"
        }
      },
      "required": ["role", "created_at"]
    },
    "usage": {
      "type": "object",
      "description": "Token 用量统计",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "description": "输入 prompt 消耗的 token 数"
        },
        "completion_tokens": {
          "type": "integer",
          "description": "生成回复消耗的 token 数"
        },
        "total_tokens": {
          "type": "integer",
          "description": "总 token 数"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "响应创建时间，ISO 8601 格式"
    },
    "extra": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "扩展数据"
    }
  },
  "required": ["id", "model", "message"]
}
